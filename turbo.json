{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "BOOKING_ACCESS_TOKEN_SECRET", "ALLOWED_ORIGINS", "ALLOW_DEMO_RESEED", "NEXT_PUBLIC_API_URL", "APP_MODE", "PAYMENT_PROVIDER", "EMAIL_PROVIDER", "INVOICE_STORAGE", "BACKGROUND_JOB_MODE", "TURNSTILE_MODE", "DEMO_ADMIN_EMAIL", "DEMO_ADMIN_PASSWORD", "ADMIN_EMAIL", "ADMIN_PASSWORD", "ADMIN_SESSION_SECRET", "PAKASIR_PROJECT_SLUG", "PAKASIR_API_KEY", "PAKASIR_BASE_URL", "PAKASIR_REDIRECT_BASE_URL", "TURNSTILE_SECRET_KEY", "NEXT_PUBLIC_TURNSTILE_SITE_KEY", "TURNSTILE_LOCAL_BYPASS", "NEXT_PUBLIC_TURNSTILE_LOCAL_BYPASS", "NEXT_PUBLIC_GLAMPING_BANK_NAME", "NEXT_PUBLIC_GLAMPING_BANK_ACCOUNT", "NEXT_PUBLIC_GLAMPING_BANK_HOLDER", "NEXT_PUBLIC_HOMESTAY_BANK_NAME", "NEXT_PUBLIC_HOMESTAY_BANK_ACCOUNT", "NEXT_PUBLIC_HOMESTAY_BANK_HOLDER", "NEXT_PUBLIC_JEEP_BANK_NAME", "NEXT_PUBLIC_JEEP_BANK_ACCOUNT", "NEXT_PUBLIC_JEEP_BANK_HOLDER", "NEXT_PUBLIC_ADMIN_WHATSAPP", "R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "R2_BUCKET_NAME", "R2_PAYMENT_PROOFS_BUCKET_NAME", "RESEND_API_KEY", "RESEND_FROM_EMAIL", "INNGEST_EVENT_KEY", "INNGEST_SIGNING_KEY", "VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY", "VAPID_SUBJECT", "SHAKILA_REPORT_LOGO_PATH", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
